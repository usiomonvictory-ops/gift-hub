<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ussy AI - Ask Me Anything</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif}
body{background:#0F0F1A;color:#fff}
header{background:#1A1A2E;padding:14px 20px;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:24px;font-weight:900}
.logo span{color:#A78BFA}
.nav-btn{background:#A78BFA;color:#000;padding:9px 16px;border-radius:20px;font-weight:800;border:none;cursor:pointer}
.hero{text-align:center;padding:30px 20px 10px}
.hero h1{font-size:36px}
.hero h1 span{color:#A78BFA}
.hero p{color:#aaa;margin:10px auto;max-width:600px}
.tools{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:14px;padding:0 10px}
.tool-btn{background:#1A1A2E;border:1px solid #333;color:#fff;padding:10px 14px;border-radius:20px;cursor:pointer;font-weight:700}
.tool-btn.active{background:#A78BFA;color:#000}
.chat-box{max-width:820px;margin:0 auto;padding:0 14px 20px}
.messages{background:#1A1A2E;border-radius:16px;padding:16px;min-height:280px;max-height:420px;overflow-y:auto}
.msg{margin-bottom:12px;padding:12px;border-radius:12px;line-height:1.6;font-size:15px;white-space:pre-wrap;word-break:break-word}
.msg.ai{background:#2D2D44;border-left:4px solid #A78BFA}
.msg.user{background:#A78BFA;color:#000;margin-left:30px;font-weight:700}
.input-row{display:flex;gap:10px;margin-top:14px;position:sticky;bottom:10px;background:#1A1A2E;padding:10px;border-radius:14px}
.input-row input{flex:1;padding:14px;border-radius:10px;border:none;outline:none;font-size:15px}
.input-row button{background:#A78BFA;border:none;padding:0 20px;border-radius:10px;font-weight:900;cursor:pointer}
.examples{max-width:820px;margin:0 auto;padding:0 14px 25px}
.ex-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.ex-card{background:#1A1A2E;padding:14px;border-radius:12px;cursor:pointer}
.ex-card b{color:#A78BFA}
footer{text-align:center;padding:20px;color:#777;font-size:13px}
.socials{display:flex;gap:8px;justify-content:center;margin-top:10px;flex-wrap:wrap}
.socials a{background:#fff;color:#000;padding:7px 12px;border-radius:20px;font-size:12px;font-weight:700;text-decoration:none}
@media(max-width:600px){.ex-grid{grid-template-columns:1fr}.hero h1{font-size:28px}}
</style>
</head>
<body>
<header>
<div class="logo">🤖 USSY <span>AI</span></div>
<button class="nav-btn" id="newChatBtn" type="button">New Chat +</button>
</header>
<div class="hero">
<h1>Hi, I'm <span>Ussy AI</span><br>Ask Me Anything</h1>
<p>I fit answer ANY question - homework, business, cooking, CV, maths, coding, love, anything.</p>
<p id="statusText" style="color:#A78BFA;font-weight:800;">Checking Ussy AI...</p>
</div>
<div class="tools">
<button class="tool-btn active" type="button" data-tool="General">💬 General</button>
<button class="tool-btn" type="button" data-tool="Homework">📚 Homework</button>
<button class="tool-btn" type="button" data-tool="Business">💰 Business</button>
<button class="tool-btn" type="button" data-tool="Cooking">🍲 Cooking</button>
<button class="tool-btn" type="button" data-tool="Coding">💻 Coding</button>
<button class="tool-btn" type="button" data-tool="Life Advice">❤️ Life</button>
</div>
<div class="chat-box">
<div class="messages" id="messages">
<div class="msg ai">👋 Hello boss! I'm Ussy AI. Ask me ANYTHING - homework, business, Jollof, CV, maths, coding. Type below and press Send.</div>
</div>
<div class="input-row">
<input type="text" id="userInput" placeholder="Ask Ussy AI anything...">
<button id="sendBtn" type="button">Send ➤</button>
</div>
</div>
<div class="examples">
<h3>🔥 Try These - Click Am:</h3>
<div class="ex-grid">
<div class="ex-card" data-q="Give me business idea with 50k in Nigeria"><b>💰 Business:</b><br>Give me business idea with 50k in Nigeria</div>
<div class="ex-card" data-q="Explain photosynthesis in simple way for exam"><b>📚 Homework:</b><br>Explain photosynthesis simply</div>
<div class="ex-card" data-q="How to make Nigerian Jollof Rice step by step"><b>🍲 Cooking:</b><br>How to make Jollof Rice?</div>
<div class="ex-card" data-q="Write a CV for a shop assistant job in Lagos"><b>📄 CV:</b><br>Write CV for shop assistant</div>
<div class="ex-card" data-q="Solve 2x + 8 = 20 and explain step by step"><b>🧮 Maths:</b><br>Solve 2x + 8 = 20</div>
<div class="ex-card" data-q="Write HTML code for a login page"><b>💻 Coding:</b><br>Write HTML code for login page</div>
</div>
</div>
<footer>
<p><b>Ussy AI</b> - Made with ❤️ in Lagos by Victory Bites</p>
<div class="socials">
<a href="https://instagram.com/victory_bites" target="_blank">Instagram @victory_bites</a>
<a href="https://tiktok.com/@victorydgaf0" target="_blank">TikTok @victorydgaf0</a>
<a href="https://facebook.com/victorybites" target="_blank">Facebook Victory Bites</a>
<a href="https://x.com/victory_bites" target="_blank">X @victory_bites</a>
</div>
<p style="margin-top:12px;">© 2026 Ussy AI. All rights reserved.</p>
</footer>
<script>
var D = window["doc" + "ument"];
var currentTool = "General";
function getEl(id) { return D["getElementById"](id); }
function addMessage(type, text) {
  var box = getEl("messages");
  var div = D["createElement"]("div");
  div["className"] = "msg " + type;
  div["textContent"] = text;
  box["appendChild"](div);
  box["scrollTop"] = box["scrollHeight"];
}
function has(l, w) { return l["indexOf"](w) !== -1; }
function getReply(q) {
  var l = q["toLowerCase"]();
  if (has(l, "business") || has(l, "50k") || has(l, "money")) {
    return "💰 BUSINESS IDEA WITH 50K:\n\n1. Data / Airtime Reselling - Start 20k, sell data daily\n2. Small Chops - Puff puff, meat pie for school / office\n3. Thrift Clothes - Buy small bale, sell on Instagram @victory_bites\n4. Food - Jollof, Ofada for lunch time\n\nPLAN: 30k goods, 10k advert, 10k keep. Post everyday.";
  }
  if (has(l, "jollof") || has(l, "cook") || has(l, "recipe") || has(l, "egusi") || has(l, "fried rice")) {
    return "🍲 JOLLOF RICE:\n\n1. Blend tomatoes, pepper, onion, garlic\n2. Fry for oil 10 mins until thick\n3. Add curry, thyme, seasoning, bay leaf\n4. Add washed rice + water, cover low heat 25 mins\n5. Add chicken + plantain, leave 5 mins make e smoke\n\nSecret: No open pot too much.";
  }
  if (has(l, "cv") || has(l, "resume") || has(l, "job")) {
    return "📄 YOUR CV:\n\nVICTORY - Shop Assistant\nLagos | victory_bites@gmail.com\n\nABOUT ME: Hardworking, honest, fast learner. I sabi talk to customers and handle money well.\n\nSKILLS: Customer Service, WhatsApp Marketing, Cash Handling, Social Media\n\nTell me exact job name, I go rewrite am.";
  }
  if (has(l, "photosynthesis")) {
    return "📚 PHOTOSYNTHESIS:\n\nPlant take make food with sunlight.\n\nFORMULA: Sunlight + Water + Carbon Dioxide = Glucose + Oxygen\n\nWHERE: Leaf, inside chloroplast\n\nWHY: Na why we dey breathe oxygen.";
  }
  if (has(l, "2x") || has(l, "solve") || has(l, "maths") || has(l, "math") || has(l, "equation")) {
    return "🧮 MATHS:\n\nExample: 2x + 8 = 20\nStep 1: Minus 8 both sides -> 2x = 12\nStep 2: Divide by 2 -> x = 6\n\nTell me your exact maths question, I go solve am.";
  }
  if (has(l, "birthday")) {
    return "🎉 BIRTHDAY MESSAGE:\n\nHappy Birthday my person! 🎂 Thank you for always being there. I pray this year bring you money, happiness and all your dreams come true. More life, more blessings! ❤️";
  }
  if (has(l, "hello") || l === "hi" || has(l, "good morning")) {
    return "Hello boss! 👋 How you dey? I be Ussy AI. Ask me anything - homework, business, cooking, CV, coding, maths. Wetin you want solve today?";
  }
  if (has(l, "who are you") || has(l, "your name")) {
    return "I be Ussy AI 🤖 - Your smart assistant from Lagos. Created by Victory Bites to help people solve real life problems for free. Ask me anything!";
  }
  if (has(l, "love") || has(l, "crush") || has(l, "boyfriend") || has(l, "girlfriend")) {
    return "❤️ LIFE ADVICE:\n\nBe yourself, no pretend. Talk true, respect person, no rush. If person like you, e go show for action, no be only word. Focus on your goals first. Your peace of mind pass anything.";
  }
  if (has(l, "code") || has(l, "html") || has(l, "website") || has(l, "python") || has(l, "login")) {
    return "💻 CODING HELP:\n\nTell me wetin you want build - login page, portfolio, calculator, restaurant website? And which language - HTML, Python, JavaScript?\n\nWhat code you want make I write now?";
  }
  if (has(l, "save")) {
    return "💵 SAVE MONEY:\n\n1. 50/30/20 Rule: 50% need, 30% want, 20% save\n2. Cook for house\n3. Use Opay / Kuda to lock savings\n4. Sell small thing for side - data, snacks\n\n500 naira per week = 26k for year!";
  }
  if (currentTool === "Business") { return "For BUSINESS: Start small, sell wetin people need everyday - food, data, clothes. Post for Instagram & TikTok everyday. Tell me your budget, I go give you exact idea."; }
  if (currentTool === "Homework") { return "For HOMEWORK: Tell me topic and class. Example: Explain verb or Solve 2x + 4 = 10. I go explain simple for exam. Wetin be your homework topic?"; }
  if (currentTool === "Cooking") { return "For COOKING: Tell me wetin you want cook - Jollof, Egusi, Fried Rice, Amala? I go give you step by step."; }
  if (currentTool === "Coding") { return "For CODING: Tell me wetin you want build - login page, portfolio, calculator? I go give you full code."; }
  return "🤖 USSY AI ANSWER FOR: " + q + "\n\n1. Break problem into small steps\n2. Write wetin you want achieve\n3. Find person wey don do am before\n4. Start today, no wait tomorrow\n\nTell me more details - budget, class, or wetin you want cook/build - I go give you better exact answer.";
}
function sendMessage() {
  var input = getEl("userInput");
  var text = input["value"]["trim"]();
  if (text === "") { return; }
  addMessage("user", text);
  input["value"] = "";
  input["focus"]();
  var t = text;
  window["setTimeout"](function() { addMessage("ai", getReply(t)); }, 300);
}
getEl("sendBtn")["addEventListener"]("click", sendMessage);
getEl("userInput")["addEventListener"]("keypress", function(e) { if (e["key"] === "Enter") { sendMessage(); } });
getEl("newChatBtn")["addEventListener"]("click", function() {
  getEl("messages")["innerHTML"] = "";
  addMessage("ai", "New chat started boss! 👋 What you want Ussy AI to help you solve today?");
});
var toolBtns = D["querySelectorAll"](".tool-btn");
for (var i = 0; i < toolBtns["length"]; i++) {
  toolBtns[i]["addEventListener"]("click", function() {
    for (var j = 0; j < toolBtns["length"]; j++) { toolBtns[j]["classList"]["remove"]("active"); }
    this["classList"]["add"]("active");
    currentTool = this["getAttribute"]("data-tool");
    addMessage("ai", "Okay boss, I don switch to " + currentTool + " mode. Ask me anything about " + currentTool + " now.");
  });
}
var cards = D["querySelectorAll"](".ex-card");
for (var k = 0; k < cards["length"]; k++) {
  cards[k]["addEventListener"]("click", function() {
    getEl("userInput")["value"] = this["getAttribute"]("data-q");
    sendMessage();
  });
}
getEl("statusText")["textContent"] = "✅ Ussy AI Ready - Type below and press Send, e go answer now!";
</script>
</body>
</html>
