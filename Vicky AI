<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ussy AI - Ask Me Anything</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Arial,sans-serif}
body{background:#0F0F1A;color:#fff;min-height:100vh}
header{background:#1A1A2E;padding:14px 20px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:100}
.logo{font-size:24px;font-weight:900}
.logo span{color:#A78BFA}
.nav-btn{background:#A78BFA;color:#000;padding:9px 16px;border-radius:20px;font-weight:800;font-size:13px;border:none;cursor:pointer}
.hero{text-align:center;padding:32px 20px 16px}
.hero h1{font-size:40px;line-height:1.1}
.hero h1 span{color:#A78BFA}
.hero p{color:#aaa;margin:12px auto;max-width:650px;line-height:1.6}
.tools{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:16px 0;padding:0 12px}
.tool-btn{background:#1A1A2E;border:1px solid #333;color:#fff;padding:10px 16px;border-radius:20px;cursor:pointer;font-size:13px;font-weight:700}
.tool-btn.active{background:#A78BFA;color:#000}
.chat-box{max-width:820px;margin:0 auto;padding:0 16px 20px}
.messages{background:#1A1A2E;border-radius:18px;padding:18px;min-height:300px;max-height:500px;overflow-y:auto}
.msg{margin-bottom:14px;padding:12px 16px;border-radius:14px;line-height:1.65;font-size:15px;white-space:pre-wrap;word-break:break-word}
.msg.ai{background:#2D2D44;border-left:4px solid #A78BFA}
.msg.user{background:#A78BFA;color:#000;margin-left:40px;font-weight:600}
.input-row{display:flex;gap:10px;margin-top:14px}
.input-row input{flex:1;padding:15px;border-radius:12px;border:none;outline:none;background:#fff;color:#000;font-size:15px}
.input-row button{background:#A78BFA;border:none;padding:0 22px;border-radius:12px;font-weight:900;cursor:pointer;font-size:16px}
.examples{max-width:820px;margin:0 auto;padding:0 16px 28px}
.examples h3{margin-bottom:12px}
.ex-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.ex-card{background:#1A1A2E;padding:14px;border-radius:12px;cursor:pointer;font-size:14px;line-height:1.5}
.ex-card:hover{border:1px solid #A78BFA}
.ex-card b{color:#A78BFA}
footer{text-align:center;padding:22px;color:#777;font-size:13px}
.socials{display:flex;gap:8px;justify-content:center;margin-top:12px;flex-wrap:wrap}
.socials a{background:#fff;color:#000;padding:7px 12px;border-radius:20px;font-size:12px;font-weight:700;text-decoration:none}
@media(max-width:600px){.hero h1{font-size:30px}.ex-grid{grid-template-columns:1fr}.msg.user{margin-left:10px}}
</style>
</head>
<body>
<header>
<div class="logo">🤖 USSY <span>AI</span></div>
<button class="nav-btn" id="newChatBtn" type="button">New Chat +</button>
</header>
<div class="hero">
<h1>Hi, I'm <span>Ussy AI</span><br>Ask Me Anything</h1>
<p>I fit answer ANY question - homework, business, cooking, CV, science, maths, health, coding, love, anything. Type am below.</p>
</div>
<div class="tools">
<button class="tool-btn active" type="button" data-tool="General">💬 General</button>
<button class="tool-btn" type="button" data-tool="Homework">📚 Homework</button>
<button class="tool-btn" type="button" data-tool="Business">💰 Business</button>
<button class="tool-btn" type="button" data-tool="Cooking">🍲 Cooking</button>
<button class="tool-btn" type="button" data-tool="Coding">💻 Coding</button>
<button class="tool-btn" type="button" data-tool="Life Advice">❤️ Life</button>
</div>
<div class="chat-box">
<div class="messages" id="messages">
<div class="msg ai">👋 Hello boss! I'm Ussy AI. Ask me ANYTHING and I go answer you - homework, business ideas, Jollof recipe, CV, maths, science, coding, anything. Try me now!</div>
</div>
<div class="input-row">
<input type="text" id="userInput" placeholder="Ask Ussy AI anything..." autocomplete="off">
<button id="sendBtn" type="button">Send ➤</button>
</div>
</div>
<div class="examples">
<h3>🔥 Try These - Click Am:</h3>
<div class="ex-grid">
<div class="ex-card" data-q="Give me business idea with 50k in Nigeria"><b>💰 Business:</b><br>Give me business idea with 50k in Nigeria</div>
<div class="ex-card" data-q="Explain photosynthesis in simple way for exam"><b>📚 Homework:</b><br>Explain photosynthesis simply</div>
<div class="ex-card" data-q="How to make Nigerian Jollof Rice step by step"><b>🍲 Cooking:</b><br>How to make Jollof Rice?</div>
<div class="ex-card" data-q="Write a CV for a shop assistant job in Lagos"><b>📄 CV:</b><br>Write CV for shop assistant</div>
<div class="ex-card" data-q="Solve 2x + 8 = 20 and explain step by step"><b>🧮 Maths:</b><br>Solve 2x + 8 = 20</div>
<div class="ex-card" data-q="Write HTML code for a login page"><b>💻 Coding:</b><br>Write HTML code for login page</div>
</div>
</div>
<footer>
<p><b>Ussy AI</b> - Made with ❤️ in Lagos by Victory Bites</p>
<div class="socials">
<a href="https://instagram.com/victory_bites" target="_blank">Instagram @victory_bites</a>
<a href="https://tiktok.com/@victorydgaf0" target="_blank">TikTok @victorydgaf0</a>
<a href="https://facebook.com/victorybites" target="_blank">Facebook Victory Bites</a>
<a href="https://x.com/victory_bites" target="_blank">X @victory_bites</a>
</div>
<p style="margin-top:12px;">© 2026 Ussy AI. All rights reserved.</p>
</footer>
<script>
var currentTool = "General";
function addMessage(type, text) {
  var box = http://document.getElementById("messages");
  var div = http://document.createElement("div");
  http://div.className = "msg " + type;
  http://div.textContent = text;
  http://box.appendChild(div);
  http://box.scrollTop = http://box.scrollHeight;
}
function getReply(q) {
  var l = http://q.toLowerCase();
  if (l.indexOf("business") !== -1 || http://l.indexOf("50k") !== -1 || http://l.indexOf("money") !== -1 || http://l.indexOf("make money") !== -1) {
    return "💰 BUSINESS IDEA WITH 50K IN NIGERIA:\n\n1. Data / Airtime Reselling - Start with 20k, sell data daily\n2. Small Chops / Snacks - Puff puff, meat pie, sell for school / office\n3. Thrift Clothes - Buy small bale, sell on Instagram @victory_bites\n4. Food Business - Jollof, Ofada, sell for lunch time\n\nPLAN: Use 30k for goods, 10k for advert on TikTok / WhatsApp, 10k keep for emergency. Post everyday. Consistency na key.";
  }
  if (l.indexOf("jollof") !== -1 || http://l.indexOf("cook") !== -1 || http://l.indexOf("recipe") !== -1 || http://l.indexOf("egusi") !== -1 || http://l.indexOf("fried rice") !== -1) {
    return "🍲 JOLLOF RICE - STEP BY STEP:\n\n1. Blend tomatoes, pepper, onion, garlic\n2. Fry for oil 10 mins until e thick\n3. Add curry, thyme, seasoning, bay leaf\n4. Add washed rice + water, cover low heat 25 mins\n5. Add chicken + plantain for top\n6. Leave 5 mins make e smoke - Party Jollof don ready!\n\nSecret: No open pot too much, na smoke dey give taste. Tell me wetin you want cook, I go give you that recipe.";
  }
  if (l.indexOf("cv") !== -1 || http://l.indexOf("resume") !== -1 || http://l.indexOf("job") !== -1) {
    return "📄 YOUR CV - COPY THIS:\n\nVICTORY - Shop Assistant\nLagos, Nigeria | victory_bites@gmail.com\n\nABOUT ME: Hardworking, honest and fast learner. I sabi talk to customers and handle money well.\n\nSKILLS: Customer Service, WhatsApp Marketing, Cash Handling, Social Media\n\nEXPERIENCE: Sales Assistant - Helped increase sales by talking to customers on WhatsApp & Instagram\n\nTell me the exact job name, I go rewrite am for that job.";
  }
  if (l.indexOf("photosynthesis") !== -1) {
    return "📚 PHOTOSYNTHESIS - SIMPLE FOR EXAM:\n\nPhotosynthesis na how plant take make their own food using sunlight.\n\nFORMULA: Sunlight + Water + Carbon Dioxide = Glucose (food) + Oxygen\n\nWHERE: For leaf, inside chloroplast\n\nWHY E IMPORTANT: Na why we dey breathe oxygen. If no photosynthesis, no life.";
  }
  if (l.indexOf("2x") !== -1 || http://l.indexOf("solve") !== -1 || http://l.indexOf("maths") !== -1 || http://l.indexOf("math") !== -1 || http://l.indexOf("equation") !== -1) {
    return "🧮 MATHS HELP:\n\nTo solve equation, do same thing for both sides.\n\nExample: 2x + 8 = 20\nStep 1: Minus 8 for both sides -> 2x = 12\nStep 2: Divide by 2 -> x = 6\n\nTell me your exact maths question, I go solve am step by step for you.";
  }
  if (l.indexOf("birthday") !== -1) {
    return "🎉 BIRTHDAY MESSAGE:\n\nHappy Birthday my person! 🎂 Thank you for always being there for me. I pray this year bring you money, happiness and all your dreams come true. More life, more blessings. Love you always! ❤️\n\nTell me their name, I go add am.";
  }
  if (l.indexOf("hello") !== -1 || l === "hi" || http://l.indexOf("good morning") !== -1 || http://l.indexOf("good evening") !== -1) {
    return "Hello boss! 👋 How you dey? I be Ussy AI, I dey here to help you. Ask me anything - homework, business, cooking, CV, coding, maths. Wetin you want solve today?";
  }
  if (l.indexOf("who are you") !== -1 || http://l.indexOf("your name") !== -1) {
    return "I be Ussy AI 🤖 - Your smart assistant from Lagos. I be created by Victory Bites to help people solve real life problems for free. Ask me anything!";
  }
  if (l.indexOf("love") !== -1 || http://l.indexOf("crush") !== -1 || http://l.indexOf("boyfriend") !== -1 || http://l.indexOf("girlfriend") !== -1) {
    return "❤️ LIFE ADVICE:\n\nFor love matter, be yourself, no pretend. Talk true, respect the person, and no rush. If person like you, e go show for action, no be only word. Focus on your goals first, love go come. Your peace of mind pass anything. Tell me wetin happen, I go advise you.";
  }
  if (l.indexOf("code") !== -1 || http://l.indexOf("html") !== -1 || http://l.indexOf("website") !== -1 || http://l.indexOf("python") !== -1 || http://l.indexOf("login") !== -1) {
    return "💻 CODING HELP:\n\nTell me exactly wetin you want build - login page, portfolio, calculator, restaurant website? And which language - HTML, Python, JavaScript?\n\nExample: 'Write HTML for login page' - I go give you full code wey you fit copy and paste.\n\nWhat code you want make I write for you now?";
  }
  if (l.indexOf("save") !== -1) {
    return "💵 HOW TO SAVE MONEY:\n\n1. Use 50/30/20 Rule: 50% need, 30% want, 20% save\n2. Cook for house, no buy food everyday\n3. Use Opay / Kuda to lock savings\n4. Sell one small thing for side - data, snacks\n\nEven if na 500 naira per week you save, for 1 year na 26k!";
  }
  if (currentTool === "Business") {
    return "For BUSINESS boss, my advice be: Start small, sell wetin people need everyday - food, data, clothes. Post for Instagram & TikTok everyday. No wait for perfect money, start with wetin you get. Tell me your budget, I go give you exact business idea.";
  }
  if (currentTool === "Homework") {
    return "For HOMEWORK, tell me the topic and class. Example: 'Explain English verb' or 'Solve 2x + 4 = 10'. I go explain am simple way wey you go understand for exam. Wetin be your homework topic?";
  }
  if (currentTool === "Cooking") {
    return "For COOKING, tell me wetin you want cook - Jollof, Egusi, Fried Rice, Amala? And wetin you get for kitchen? I go give you step by step.";
  }
  if (currentTool === "Coding") {
    return "For CODING, tell me wetin you want build - login page, portfolio, calculator? I go give you full code wey you fit copy and paste.";
  }
  return "🤖 USSY AI ANSWER FOR: " + q + "\n\nHere na my advice:\n\n1. Break the problem into small small steps\n2. Write wetin you want achieve\n3. Find one person wey don do am before\n4. Start today, no wait tomorrow\n\nTell me more details - your budget, your class, or wetin you want cook/build - I go give you better exact answer. Try click one of the examples below.";
}
function sendMessage() {
  var input = http://document.getElementById("userInput");
  var text = http://input.value.trim();
  if (text === "") return;
  addMessage("user", text);
  http://input.value = "";
  http://input.focus();
  setTimeout(function() {
    addMessage("ai", getReply(text));
  }, 400);
}
http://document.getElementById("sendBtn").addEventListener("click", sendMessage);
http://document.getElementById("userInput").addEventListener("keypress", function(e) {
  if (e.key === "Enter") sendMessage();
});
http://document.getElementById("newChatBtn").addEventListener("click", function() {
  http://document.getElementById("messages").innerHTML = "";
  addMessage("ai", "New chat started boss! 👋 What you want Ussy AI to help you solve today?");
});
var toolBtns = http://document.querySelectorAll(".tool-btn");
for (var i = 0; i < http://toolBtns.length; i++) {
  toolBtns[i].addEventListener("click", function() {
    for (var j = 0; j < http://toolBtns.length; j++) { toolBtns[j].classList.remove("active"); }
    http://this.classList.add("active");
    currentTool = http://this.getAttribute("data-tool");
    addMessage("ai", "Okay boss, I don switch to " + currentTool + " mode. Ask me anything about " + currentTool + " now.");
  });
}
var cards = http://document.querySelectorAll(".ex-card");
for (var k = 0; k < http://cards.length; k++) {
  cards[k].addEventListener("click", function() {
    http://document.getElementById("userInput").value = http://this.getAttribute("data-q");
    sendMessage();
  });
}
</script>
</body>
</html>
