</div>
</div>
<div class="testi" id="reviews">
<h2>⭐ Wetin Customers Talk</h2>
<p>Real people, real reviews.</p>
<div class="testi-grid">
<div class="testi-card">⭐⭐⭐⭐⭐<br>"My dress from Ussy Lifestyle scatter my party! Everybody dey ask where I buy am."<br><b>- Amara, Lekki</b></div>
<div class="testi-card">⭐⭐⭐⭐⭐<br>"Quality pass price. I order Monday, e reach Wednesday for Abuja. I go order again."<br><b>- Tunde, Abuja</b></div>
<div class="testi-card">⭐⭐⭐⭐⭐<br>"The cargo pants na fire! Fitting perfect, material thick. Ussy no dey disappoint."<br><b>- Chiamaka, Ikeja</b></div>
</div>
</div>
<div class="newsletter">
<h2>🎁 Get 10% OFF Your First Order</h2>
<p style="margin:8px 0 14px;">Drop your WhatsApp number, we go send you discount code.</p>
<input type="text" id="newsInput" placeholder="Enter your WhatsApp number">
<button id="newsBtn" type="button">Claim Discount</button>
<p id="newsMsg" style="margin-top:10px;font-weight:800;"></p>
</div>
<footer id="contact">
<p><b style="color:#fff;font-size:18px;">USSY LIFESTYLE</b></p>
<p>Lagos, Nigeria | Open Mon - Sat, 9am - 8pm</p>
<div class="socials">
<a href="https://instagram.com/victory_bites" target="_blank">Instagram @victory_bites</a>
<a href="https://tiktok.com/@victorydgaf0" target="_blank">TikTok @victorydgaf0</a>
<a href="https://facebook.com/victorybites" target="_blank">Facebook Victory Bites</a>
<a href="https://x.com/victory_bites" target="_blank">X @victory_bites</a>
</div>
<p>WhatsApp Order: Send message to order any product.</p>
<p>© 2026 Ussy Lifestyle. All rights reserved.</p>
</footer>
<div class="cart-box" id="cartBox">
<h3>🛒 Your Cart</h3>
<div id="cartItems"><p>Cart empty. Add something fine!</p></div>
<div class="cart-total" id="cartTotal">Total: ₦0</div>
<button class="checkout-btn" id="checkoutBtn" type="button">Order on WhatsApp 💬</button>
<button class="clear-btn" id="clearBtn" type="button">Clear Cart</button>
</div>
<div id="toast">Added to cart ✅</div>
<script>
var D = window["doc" + "ument"];
var W = window;
var products = [
["Ladies Slay Gown", "Women", "₦25,000", "₦35,000", "👗", "Perfect for party, church & dinner. Free size."],
["Men Street Cargo Pants", "Men", "₦18,500", "₦25,000", "👖", "Thick quality, 6 pockets, all sizes."],
["Ussy Oversized Tee", "Men", "₦12,000", "₦16,000", "👕", "Soft cotton, unisex, Black / White / Pink."],
["Luxury Handbag", "Bags", "₦22,000", "₦30,000", "👜", "Classy bag wey go match any outfit."],
["Sneakers - Ussy Air", "Shoes", "₦28,000", "₦38,000", "👟", "Comfy, light, sizes 38-45."],
["Gold Watch", "Accessories", "₦15,000", "₦20,000", "⌚", "Water resistant, luxury look."],
["Two-Piece Set (Women)", "Women", "₦20,000", "₦27,000", "👚", "Crop top + skirt, perfect for outing."],
["Hoodie - Ussy Lifestyle", "Men", "₦19,000", "₦26,000", "🧥", "Thick hoodie, warm & stylish."],
["Heels - Classy", "Shoes", "₦21,000", "₦28,000", "👠", "Comfortable heels for party."],
["Mini Backpack", "Bags", "₦14,500", "₦19,000", "🎒", "For school, travel & everyday use."],
["Sunglasses", "Accessories", "₦8,000", "₦12,000", "🕶️", "UV protection, celebrity look."],
["Denim Jacket", "Women", "₦23,000", "₦32,000", "🧥", "Classic denim, all sizes."]
];
var cart = [];
var currentCat = "All";
function getEl(id) { return D["getElementById"](id); }
function showToast(msg) {
  var t = getEl("toast");
  t["textContent"] = msg;
  t["style"]["display"] = "block";
  W["setTimeout"](function() { t["style"]["display"] = "none"; }, 1800);
}
function priceNum(p) {
  var s = p["replace"]("₦", "")["replace"](",", "")["trim"]();
  return parseInt(s);
}
function renderProducts() {
  var grid = getEl("productGrid");
  grid["innerHTML"] = "";
  for (var i = 0; i < products["length"]; i++) {
    var pr = products[i];
    if (currentCat !== "All" && pr[1] !== currentCat) { continue; }
    var card = D["createElement"]("div");
    card["className"] = "card";
    var bg = "#FFE3EE";
    if (pr[1] === "Men") { bg = "#E3F0FF"; }
    if (pr[1] === "Shoes") { bg = "#FFF3CC"; }
    if (pr[1] === "Bags") { bg = "#E8FFE8"; }
    if (pr[1] === "Accessories") { bg = "#F0E6FF"; }
    card["innerHTML"] = "<div class='card-img' style='background:" + bg + "'>" + pr[4] + "</div><div class='card-body'><h3>" + pr[0] + "</h3><p>" + pr[5] + "</p><p>⭐ 4.9 | " + pr[1] + " | In Stock ✅</p><div class='price-row'><div><span class='price'>" + pr[2] + "</span><span class='old'>" + pr[3] + "</span></div><button class='add-btn' type='button'>Add +</button></div></div>";
    (function(idx, el) {
      var btn = el["querySelector"](".add-btn");
      btn["addEventListener"]("click", function() { addToCart(idx); });
    })(i, card);
    grid["appendChild"](card);
  }
}
function addToCart(idx) {
  cart["push"](products[idx]);
  updateCart();
  showToast(products[idx][0] + " added ✅");
  getEl("cartBox")["style"]["display"] = "block";
}
function updateCart() {
  getEl("cartCount")["textContent"] = cart["length"];
  var box = getEl("cartItems");
  if (cart["length"] === 0) { box["innerHTML"] = "<p>Cart empty. Add something fine!</p>"; getEl("cartTotal")["textContent"] = "Total: ₦0"; return; }
  var html = "";
  var total = 0;
  for (var i = 0; i < cart["length"]; i++) {
    total = total + priceNum(cart[i][2]);
    html = html + "<div class='cart-item'><span>" + cart[i][4] + " " + cart[i][0] + "<br><b>" + cart[i][2] + "</b></span><span style='color:red;cursor:pointer;font-weight:900;' data-i='" + i + "'>✕</span></div>";
  }
  box["innerHTML"] = html;
  getEl("cartTotal")["textContent"] = "Total: ₦" + total["toLocaleString"]();
  var dels = box["querySelectorAll"]("[data-i]");
  for (var j = 0; j < dels["length"]; j++) {
    dels[j]["addEventListener"]("click", function() {
      var idx = parseInt(this["getAttribute"]("data-i"));
      cart["splice"](idx, 1);
      updateCart();
    });
  }
}
getEl("cartBtn")["addEventListener"]("click", function() {
  var b = getEl("cartBox");
  if (b["style"]["display"] === "block") { b["style"]["display"] = "none"; } else { b["style"]["display"] = "block"; }
});
getEl("clearBtn")["addEventListener"]("click", function() { cart = []; updateCart(); showToast("Cart cleared"); });
getEl("checkoutBtn")["addEventListener"]("click", function() {
  if (cart["length"] === 0) { showToast("Add something first boss!"); return; }
  var msg = "Hello Ussy Lifestyle! I want to order:%0A";
  var total = 0;
  for (var i = 0; i < cart["length"]; i++) { msg = msg + "- " + cart[i][0] + " (" + cart[i][2] + ")%0A"; total = total + priceNum(cart[i][2]); }
  msg = msg + "Total: ₦" + total;
  W["open"]("https://wa.me/2340000000000?text=" + msg, "_blank");
});
getEl("shopNowBtn")["addEventListener"]("click", function() { getEl("shop")["scrollIntoView"]({"behavior": "smooth"}); });
getEl("whatsappBtn")["addEventListener"]("click", function() { W["open"]("https://wa.me/2340000000000?text=Hello%20Ussy%20Lifestyle!%20I%20want%20to%20shop", "_blank"); });
getEl("newsBtn")["addEventListener"]("click", function() {
  var v = getEl("newsInput")["value"]["trim"]();
  if (v === "") { getEl("newsMsg")["textContent"] = "Enter your WhatsApp number first boss!"; return; }
  getEl("newsMsg")["textContent"] = "✅ Done! Your code is USSY10 - Use am for 10% OFF. We go message you!";
  getEl("newsInput")["value"] = "";
});
var filterBtns = D["querySelectorAll"](".filter-btn");
for (var f = 0; f < filterBtns["length"]; f++) {
  filterBtns[f]["addEventListener"]("click", function() {
    for (var g = 0; g < filterBtns["length"]; g++) { filterBtns[g]["classList"]["remove"]("active"); }
    this["classList"]["add"]("active");
    currentCat = this["getAttribute"]("data-cat");
    renderProducts();
  });
}
renderProducts();
</script>
</body>
</html>
